extends SceneTree

func _initialize() -> void:
	call_deferred("_run")

func _run() -> void:
	var store: GDScript = load("res://scripts/dev/tuning_store.gd")
	var world_script: GDScript = load("res://scripts/sim/world.gd")
	var tuning: Node = root.get_node("Tuning")
	var original: Dictionary = store.snapshot()
	var factory: Dictionary = store.defaults()
	var names: Array[String] = store.fields()
	assert(names.has("WALK_SPEED") and names.has("HUD_PLAYER_COLORS"))
	assert(not names.has("name") and not names.has("MAX_GROUND_ANGLE") and not names.has("TICK_RATE"))
	var wire: Dictionary = store.encode(original)
	var parsed: Variant = JSON.parse_string(JSON.stringify(wire, "", true, true))
	var decoded: Dictionary = store.decode(parsed)
	assert(decoded == original)
	assert(decoded.HUD_PLAYER_COLORS.is_typed())
	assert(decoded.HUD_PLAYER_COLORS.get_typed_builtin() == TYPE_COLOR)
	assert(decoded.HUD_REFERENCE_SIZE is Vector2)
	assert(decoded.CAMERA_MENU_POSITION is Vector3)
	assert(decoded.VIS_EDGE_COLOR is Color)
	assert(store.decode({"NO_SUCH_FIELD": 1}).is_empty())
	assert(store.decode({"WALK_SPEED": "fast"}).is_empty())
	assert(store.decode({"WALK_SPEED": INF}).is_empty())
	assert(store.decode({"STOCKS": 1.5}).is_empty())
	assert(store.decode({"BODY_HEIGHT": 0}).is_empty())
	assert(store.decode({"AUDIO_SAMPLE_RATE": -1}).is_empty())
	assert(store.decode({"SHOVE_WINDUP": -0.1}).is_empty())
	assert(store.decode({"HUD_REFERENCE_SIZE": {"type": "Vector2", "value": [0, 800]}}).is_empty())
	assert(not store.decode({"KILL_PLANE": -20.0, "CAMERA_MIN_PITCH": -1.0}).is_empty())
	store.apply({"STOCKS": 7, "WALK_SPEED": factory.WALK_SPEED * 1.2})
	assert(tuning.STOCKS == 7)
	var changed: Dictionary = world_script.create([1, 2])
	assert(changed.players[1].stocks == 7)
	assert(store.defaults() == factory)
	assert(store.save("user://presets/tuning-test.json", store.snapshot()) == OK)
	var saved: Dictionary = store.load_values("user://presets/tuning-test.json")
	assert(saved == store.snapshot())
	store.apply(factory)
	assert(store.snapshot() == factory)
	store.apply({"STOCKS": -1})
	assert(tuning.STOCKS == factory.STOCKS)
	for preset in ["Source-tight", "Quake-fast", "Chaos"]:
		var values: Dictionary = store.load_values("res://presets/" + preset + ".json")
		assert(not values.is_empty())
		store.apply(values)
		for name in values:
			assert(tuning.get(name) == values[name])
		var world: Dictionary = world_script.create([1, 2])
		assert(world.players[1].stocks == tuning.STOCKS)
		assert(is_equal_approx(world.players[1].position.y, world_script.floor_height(world.players[1].position) + tuning.BODY_HEIGHT * 0.5))
	store.apply(original)
	DirAccess.remove_absolute("user://presets/tuning-test.json")
	print("PASS tuning typed JSON, invalid rejection, factory reset, persistence, preset World effects")
	quit(0)
